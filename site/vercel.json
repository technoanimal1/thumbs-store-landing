{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/preprod/pricing",
      "destination": "/pricing",
      "permanent": false
    },
    { "source": "/apply", "destination": "https://app.thumbs.store/signup", "permanent": true },
    { "source": "/terms", "destination": "/license", "permanent": true },
    { "source": "/partners", "destination": "/providers", "permanent": true },
    { "source": "/blog/casino-game-thumbnails-the-ultimate-guide-for-igaming-operators", "destination": "/providers", "permanent": true },
    { "source": "/blog/how-setanta.bet-solved-website-thumbnail-problems-with-thumbs.store", "destination": "/blog/why-hand-made-thumbnails-dont-scale", "permanent": true },
    { "source": "/blog/igaming-ui-assets-how-to-build-a-scalable-visual-system-for-your-platform", "destination": "/blog/inside-the-studio", "permanent": true },
    { "source": "/blog/slot-game-graphics-for-operators-what-you-need-to-know", "destination": "/blog/thumbs-store-vs-aggregator-thumbnails", "permanent": true },
    { "source": "/blog/((?!why-hand-made-thumbnails-dont-scale|automatic-updates-and-the-api|one-flat-price-every-release-included|thumbs-store-vs-aggregator-thumbnails|inside-the-studio).*)", "destination": "/blog", "permanent": true },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "thumbs.store"
        }
      ],
      "destination": "https://www.thumbs.store/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(favicon.svg|og.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/coverage-private(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
