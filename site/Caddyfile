{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# Canonical host: the bare domain redirects to www (canonicals + sitemap
	# point at https://www.thumbs.store).
	@apex host thumbs.store
	redir @apex https://www.thumbs.store{uri} permanent

	# Account administration lives in the dashboard app, not on this site, but
	# it gets the short address because that is the one worth remembering.
	# A 302, not a 301: browsers cache a permanent redirect forever, and this
	# is a convenience link, not a fact about the site's shape.
	redir /admin https://app.thumbs.store/admin
	redir /admin/* https://app.thumbs.store/admin

	root * /srv
	encode gzip

	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header X-Frame-Options SAMEORIGIN

	try_files {path} {path}.html {path}/index.html

	handle_errors {
		rewrite * /404.html
		file_server
	}

	file_server
}
